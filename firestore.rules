rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedItineraries/japan-trip {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['state', 'updatedAt']) &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.state is map &&
        request.resource.data.state.places is list &&
        request.resource.data.state.hotels is list &&
        request.resource.data.state.plan is map &&
        request.resource.data.state.places.size() <= 500 &&
        request.resource.data.state.hotels.size() <= 100;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
